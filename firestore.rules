rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /barbershops/{barberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == barberId;
    }

    match /appointments/{appointmentId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.clientId ||
         request.auth.uid == resource.data.barberId);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.clientId;

      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.clientId ||
         request.auth.uid == resource.data.barberId) &&
        (request.resource.data.status == resource.data.status ||
         request.resource.data.status == 'cancelled');

      allow delete: if false;
    }

    match /slots/{slotId} {
      allow read, create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.barberId ||
         request.auth.uid == resource.data.clientId ||
         resource.data.clientId == null);
    }

    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.clientId &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.clientId &&
        request.resource.data.clientId == resource.data.clientId &&
        request.resource.data.barberId == resource.data.barberId &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow delete: if false;
    }

    match /monthly_plans/{planId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == request.resource.data.clientId;
      allow delete: if false;
    }

    match /clientes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /app_agenda/{docId} {
      allow read, write: if request.auth != null;
    }

    match /unavailable_hours/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
